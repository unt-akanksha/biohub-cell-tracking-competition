{
  "schema_version": 1,
  "patterns": [
    {
      "id": "explicit-metric-hack-language",
      "scope": "title",
      "regex": "metric[ _-]*hack|score[ _-]*exploit",
      "severity": "explicit"
    },
    {
      "id": "enabled-metric-hack-flag",
      "scope": "source",
      "regex": "metric[ _-]*hack(?:[ _-]*(?:used|enabled|mode))?[\\\"']?\\s*[:=]\\s*(?:true|1|[\\\"'](?:on|enabled)[\\\"'])",
      "severity": "explicit"
    },
    {
      "id": "fake-division-language",
      "scope": "source",
      "regex": "fake.{0,40}(division|fork|hub)|(division|fork|hub).{0,40}fake",
      "severity": "explicit"
    },
    {
      "id": "negative-time-sentinel",
      "scope": "source",
      "regex": "(?:(?:sentinel|fake|exploit).{0,120}(?:time|frame|t)[\\\"']?\\s*[:=]\\s*-[1-9][0-9]*|(?:time|frame|t)[\\\"']?\\s*[:=]\\s*-[1-9][0-9]*.{0,120}(?:sentinel|fake|exploit))",
      "severity": "explicit"
    },
    {
      "id": "out-of-volume-sentinel",
      "scope": "source",
      "regex": "(?:sentinel|fake|exploit).{0,80}(?:1e[6-9]|1000000|out.of.volume)",
      "severity": "explicit"
    }
  ]
}
